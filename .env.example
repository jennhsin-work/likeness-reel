ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5

# Generators. With none set the app runs in free, local preview mode.
FAL_KEY=
RUNWAY_API_KEY=
LUMA_API_KEY=
PUBLIC_MEDIA_URL=

